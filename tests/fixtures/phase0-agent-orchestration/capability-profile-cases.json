      "split": "test",
      "action": "resolve_profile",
      "query": "unknown.profile",
      "expected_code": "unknown_profile"
    },
    {
      "id": "ambiguous-field-alias",
      "split": "held_out_adversarial",
      "action": "resolve_field",
      "query": "batch limit",
      "mutation": {
        "operation": "append",
        "pointer": "/catalog/parameter_descriptors/1/aliases",
        "value": "batch limit"
      },
      "expected_code": "ambiguous_alias"
    },
    {
      "id": "ambiguous-profile-alias",
