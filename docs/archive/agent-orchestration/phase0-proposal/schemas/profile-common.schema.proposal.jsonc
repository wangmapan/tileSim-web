{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilesim.local/proposals/agent-orchestration-phase0/profile-common.schema.json",
  "x-tilesim-contract-status": "proposal_only",
  "$defs": {
    "profileEnvelope": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_status",
        "profile_family",
        "profile_id",
        "profile_revision",
        "canonical_digest",
        "canonicalization",
        "digest_material_fields",
        "aliases",
        "owner_module",
        "status",
        "reason_code",
        "sources",
        "valid_regimes",
        "field_provenance",
        "lifecycle",
        "compatibility"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^tilesim\\.proposal\\.agent_orchestration\\.[a-z_]+_profile\\.v1alpha1$"
        },
        "contract_status": {
          "const": "proposal_only"
        },
        "profile_family": {
          "enum": [
            "model",
            "engine",
            "device",
            "topology",
            "workload"
          ]
        },
        "profile_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "profile_revision": {
          "$ref": "common.schema.json#/$defs/revision"
        },
        "canonical_digest": {
          "$ref": "common.schema.json#/$defs/revision"
        },
        "canonicalization": {
          "$ref": "common.schema.json#/$defs/canonicalization"
        },
        "digest_material_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true,
          "not": {
            "contains": {
              "const": "canonical_digest"
            }
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locale",
              "term"
            ],
            "properties": {
              "locale": {
                "enum": [
                  "en-US",
                  "zh-CN"
                ]
              },
              "term": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "uniqueItems": true
        },
        "owner_module": {
          "$ref": "common.schema.json#/$defs/ownerModule"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/supportStatus"
        },
        "reason_code": {
          "$ref": "common.schema.json#/$defs/reasonCode"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/sourceRecord"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "valid_regimes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/regime"
          },
          "minItems": 1
        },
        "field_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed_fields",
            "inferred_fields",
            "modelled_fields",
            "unknown_fields"
          ],
          "properties": {
            "observed_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/"
              },
              "uniqueItems": true
            },
            "inferred_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/"
              },
              "uniqueItems": true
            },
            "modelled_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/"
              },
              "uniqueItems": true
            },
            "unknown_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/"
              },
              "uniqueItems": true
            }
          }
        },
        "lifecycle": {
          "$ref": "common.schema.json#/$defs/lifecycle"
        },
        "compatibility": {
          "$ref": "common.schema.json#/$defs/compatibility"
        }
      }
    },
    "featureSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_code",
        "conditions",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "$ref": "common.schema.json#/$defs/supportStatus"
        },
        "reason_code": {
          "$ref": "common.schema.json#/$defs/reasonCode"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evidenceReference"
          },
          "uniqueItems": true
        }
      }
    },
    "typedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "revision"
      ],
      "properties": {
        "identity": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/revision"
        }
      }
    }
  }
}
