{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilesim.local/proposals/agent-orchestration-phase0/parameter-descriptor.schema.json",
  "x-tilesim-contract-status": "proposal_only",
  "x-tilesim-schema-identity": "tilesim.proposal.agent_orchestration.parameter_descriptor.v1alpha1",
  "title": "Phase0ParameterDescriptorProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_status",
    "descriptor_id",
    "descriptor_revision",
    "canonical_digest",
    "canonicalization",
    "digest_material_fields",
    "field_id",
    "aliases",
    "owner_module",
    "compatibility_subsystem",
    "value_type",
    "canonical_unit",
    "accepted_units",
    "constraints",
    "applicability",
    "default_policy",
    "request_target",
    "lowering",
    "evidence_outputs",
    "sensitivity",
    "status",
    "status_reason_code",
    "blocking_dependencies",
    "alternatives",
    "dimensions",
    "lifecycle",
    "compatibility"
  ],
  "properties": {
    "schema_version": {
      "const": "tilesim.proposal.agent_orchestration.parameter_descriptor.v1alpha1"
    },
    "contract_status": {
      "const": "proposal_only"
    },
    "descriptor_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "descriptor_revision": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "canonical_digest": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "canonicalization": {
      "$ref": "common.schema.json#/$defs/canonicalization"
    },
    "digest_material_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true,
      "not": {
        "contains": {
          "const": "canonical_digest"
        }
      }
    },
    "field_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locale",
          "term"
        ],
        "properties": {
          "locale": {
            "enum": [
              "en-US",
              "zh-CN"
            ]
          },
          "term": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    },
    "owner_module": {
      "$ref": "common.schema.json#/$defs/ownerModule"
    },
    "compatibility_subsystem": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3",
        "S4",
        "S5",
        "S6",
        null
      ]
    },
    "value_type": {
      "enum": [
        "string",
        "enum",
        "boolean",
        "int",
        "uint64",
        "decimal",
        "object",
        "list",
        "reference"
      ]
    },
    "canonical_unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "accepted_units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit",
          "scale_decimal",
          "case_sensitive"
        ],
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "scale_decimal": {
            "$ref": "common.schema.json#/$defs/decimalString"
          },
          "case_sensitive": {
            "type": "boolean"
          }
        }
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_decimal",
        "maximum_decimal",
        "step_decimal",
        "enum_values",
        "minimum_items",
        "maximum_items",
        "relation_rule_ids"
      ],
      "properties": {
        "minimum_decimal": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/decimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "maximum_decimal": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/decimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "step_decimal": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/decimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "enum_values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "minimum_items": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maximum_items": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "relation_rule_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/stableId"
          },
          "uniqueItems": true
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "condition_ids",
        "not_applicable_reason_codes"
      ],
      "properties": {
        "mode": {
          "enum": [
            "always",
            "conditional"
          ]
        },
        "condition_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "not_applicable_reason_codes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/reasonCode"
          },
          "uniqueItems": true
        }
      }
    },
    "default_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_identity",
        "source_revision"
      ],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "profile",
            "template",
            "system"
          ]
        },
        "source_identity": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_revision": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "request_target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_schema_identity",
            "json_pointer"
          ],
          "properties": {
            "request_schema_identity": {
              "$ref": "common.schema.json#/$defs/stableId"
            },
            "json_pointer": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "lowering": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage_id",
            "owner_module",
            "output_identity"
          ],
          "properties": {
            "stage_id": {
              "$ref": "common.schema.json#/$defs/stableId"
            },
            "owner_module": {
              "$ref": "common.schema.json#/$defs/ownerModule"
            },
            "output_identity": {
              "$ref": "common.schema.json#/$defs/stableId"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_outputs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidenceReference"
      },
      "uniqueItems": true
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "restricted",
        "secret"
      ]
    },
    "status": {
      "$ref": "common.schema.json#/$defs/supportStatus"
    },
    "status_reason_code": {
      "$ref": "common.schema.json#/$defs/reasonCode"
    },
    "blocking_dependencies": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "alternatives": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "described",
        "accepted",
        "validated",
        "lowered",
        "executed",
        "observable",
        "calibrated",
        "held_out_validated",
        "ui_exposed",
        "agent_exposed"
      ],
      "properties": {
        "described": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "accepted": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "validated": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "lowered": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "executed": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "observable": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "calibrated": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "held_out_validated": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "ui_exposed": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "agent_exposed": {
          "$ref": "common.schema.json#/$defs/dimension"
        }
      }
    },
    "lifecycle": {
      "$ref": "common.schema.json#/$defs/lifecycle"
    },
    "compatibility": {
      "$ref": "common.schema.json#/$defs/compatibility"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dimensions": {
            "properties": {
              "accepted": {
                "properties": {
                  "state": {
                    "const": "affirmed"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "request_target": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dimensions": {
            "properties": {
              "lowered": {
                "properties": {
                  "state": {
                    "const": "affirmed"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "lowering": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dimensions": {
            "properties": {
              "executed": {
                "properties": {
                  "state": {
                    "const": "affirmed"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "dimensions": {
            "properties": {
              "lowered": {
                "properties": {
                  "state": {
                    "const": "affirmed"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dimensions": {
            "properties": {
              "observable": {
                "properties": {
                  "state": {
                    "const": "affirmed"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "dimensions": {
            "properties": {
              "executed": {
                "properties": {
                  "state": {
                    "const": "affirmed"
                  }
                }
              }
            }
          },
          "evidence_outputs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dimensions": {
            "properties": {
              "held_out_validated": {
                "properties": {
                  "state": {
                    "const": "affirmed"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "dimensions": {
            "properties": {
              "calibrated": {
                "properties": {
                  "state": {
                    "const": "affirmed"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dimensions": {
            "properties": {
              "agent_exposed": {
                "properties": {
                  "state": {
                    "const": "affirmed"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "sensitivity": {
            "not": {
              "const": "secret"
            }
          },
          "dimensions": {
            "properties": {
              "described": {
                "properties": {
                  "state": {
                    "const": "affirmed"
                  }
                }
              },
              "accepted": {
                "properties": {
                  "state": {
                    "const": "affirmed"
                  }
                }
              },
              "validated": {
                "properties": {
                  "state": {
                    "const": "affirmed"
                  }
                }
              },
              "lowered": {
                "properties": {
                  "state": {
                    "const": "affirmed"
                  }
                }
              },
              "executed": {
                "properties": {
                  "state": {
                    "const": "affirmed"
                  }
                }
              },
              "observable": {
                "properties": {
                  "state": {
                    "const": "affirmed"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unresolved_not_executed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "dimensions": {
            "properties": {
              "executed": {
                "properties": {
                  "state": {
                    "enum": [
                      "unknown",
                      "denied"
                    ]
                  }
                }
              },
              "agent_exposed": {
                "properties": {
                  "state": {
                    "const": "denied"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
