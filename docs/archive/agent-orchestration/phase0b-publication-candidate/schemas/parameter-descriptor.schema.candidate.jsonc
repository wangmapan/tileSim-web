{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilesim.local/publication-candidates/agent-orchestration-phase0b/parameter-descriptor.schema.json",
  "x-tilesim-contract-status": "publication_candidate",
  "x-tilesim-schema-identity": "tilesim.bridge.agent_orchestration_parameter_descriptor.v1",
  "title": "AgentOrchestrationParameterDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "field_id",
    "owner_module",
    "value_type",
    "canonical_unit",
    "accepted_units",
    "constraints",
    "applicability",
    "request_identity",
    "request_json_pointer",
    "lowering_stage",
    "execution_evidence",
    "capability_state",
    "reason_codes",
    "claim_scope_ceiling",
    "resolved_fidelity"
  ],
  "properties": {
    "field_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "owner_module": {
      "$ref": "common.schema.json#/$defs/ownerModule"
    },
    "value_type": {
      "enum": ["enum", "integer", "number"]
    },
    "canonical_unit": {
      "type": "string",
      "minLength": 1
    },
    "accepted_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "object",
      "minProperties": 1
    },
    "applicability": {
      "type": "object",
      "required": ["status", "conditions"],
      "properties": {
        "status": {
          "$ref": "common.schema.json#/$defs/supportState"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "request_identity": {
      "const": "tilesim.bridge.create_run_request.v1"
    },
    "request_json_pointer": {
      "$ref": "common.schema.json#/$defs/jsonPointer"
    },
    "lowering_stage": {
      "type": "string",
      "minLength": 1
    },
    "execution_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/evidenceReference"
      }
    },
    "capability_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "described",
        "accepted",
        "validated",
        "lowered",
        "executed",
        "observable",
        "calibrated",
        "held_out_validated",
        "agent_exposed"
      ],
      "properties": {
        "described": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "accepted": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "validated": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "lowered": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "executed": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "observable": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "calibrated": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "held_out_validated": {
          "$ref": "common.schema.json#/$defs/dimension"
        },
        "agent_exposed": {
          "$ref": "common.schema.json#/$defs/dimension"
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/reasonCode"
      },
      "uniqueItems": true
    },
    "claim_scope_ceiling": {
      "type": "array",
      "items": {
        "enum": ["exploration", "synthetic_consistency"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "resolved_fidelity": {
      "enum": ["Analytical", "DES", "mixed"]
    }
  }
}
