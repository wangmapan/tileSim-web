{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilesim.local/publication-candidates/agent-orchestration-phase0b/topology-profile.schema.json",
  "x-tilesim-contract-status": "publication_candidate",
  "x-tilesim-schema-identity": "tilesim.bridge.agent_orchestration_topology_profile.v1",
  "title": "AgentOrchestrationTopologyProfile",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/profileEnvelope"
    },
    {
      "type": "object",
      "required": [
        "devices",
        "endpoints",
        "domains",
        "links",
        "ports",
        "network_classes",
        "link_characteristics",
        "routing_binding",
        "transport_binding",
        "collective_binding",
        "placement_constraints",
        "disabled_resources",
        "applicable_scale",
        "calibration_receipt",
        "demand_execution_ownership"
      ],
      "properties": {
        "schema_identity": {
          "const": "tilesim.bridge.agent_orchestration_topology_profile.v1"
        },
        "profile_family": {
          "const": "topology"
        },
        "devices": {
          "$ref": "common.schema.json#/$defs/factAssertion"
        },
        "endpoints": {
          "$ref": "common.schema.json#/$defs/factAssertion"
        },
        "domains": {
          "$ref": "common.schema.json#/$defs/factAssertion"
        },
        "links": {
          "$ref": "common.schema.json#/$defs/factAssertion"
        },
        "ports": {
          "$ref": "common.schema.json#/$defs/factAssertion"
        },
        "network_classes": {
          "$ref": "common.schema.json#/$defs/factAssertion"
        },
        "link_characteristics": {
          "$ref": "common.schema.json#/$defs/factAssertion"
        },
        "routing_binding": {
          "$ref": "common.schema.json#/$defs/factAssertion"
        },
        "transport_binding": {
          "$ref": "common.schema.json#/$defs/factAssertion"
        },
        "collective_binding": {
          "$ref": "common.schema.json#/$defs/factAssertion"
        },
        "placement_constraints": {
          "$ref": "common.schema.json#/$defs/factAssertion"
        },
        "disabled_resources": {
          "$ref": "common.schema.json#/$defs/factAssertion"
        },
        "applicable_scale": {
          "$ref": "common.schema.json#/$defs/factAssertion"
        },
        "calibration_receipt": {
          "$ref": "common.schema.json#/$defs/factAssertion"
        },
        "demand_execution_ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "communication_demand_owner",
            "path_queue_congestion_completion_owner"
          ],
          "properties": {
            "communication_demand_owner": {
              "const": "集合通信语义模块"
            },
            "path_queue_congestion_completion_owner": {
              "const": "网络与硬件资源模块"
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
