{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TileSim 工作台",
  "version": "0.1.0",
  "identifier": "io.tilesim.workbench",
  "build": {
    "beforeDevCommand": "pnpm launcher:dev",
    "devUrl": "http://127.0.0.1:4187",
    "beforeBuildCommand": "pnpm launcher:build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TileSim 工作台",
        "width": 1180,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "TileSim Windows 本地工作台",
    "longDescription": "TileSim 本地服务、部署、模型配置与环境诊断工作台"
  }
}
