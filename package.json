{
  "name": "tilesim-evidence-studio",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && pnpm launcher:build:web",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && pnpm launcher:test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test && pnpm launcher:test:e2e",
    "typecheck": "vue-tsc --noEmit && pnpm launcher:typecheck",
    "contracts:generate": "node scripts/generate-contract-types.mjs && node scripts/generate-bridge-client.mjs",
    "contracts:check": "node scripts/generate-contract-types.mjs --check && node scripts/generate-bridge-client.mjs --check",
    "docs:check": "node scripts/check-doc-links.mjs",
    "deps:check": "node scripts/check-frontend-dependencies.mjs",
    "perf:artifact-baseline": "node --expose-gc scripts/measure-artifact-baseline.mjs",
    "perf:artifact-worker": "vite-node scripts/measure-artifact-worker-baseline.ts",
    "release:identity": "node scripts/release-identity.mjs",
    "release:rehearse": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rehearse-release.ps1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "launcher:dev": "vite --config tools/workbench-launcher/vite.config.js",
    "launcher:build:web": "vite build --config tools/workbench-launcher/vite.config.js",
    "launcher:test": "vitest run --config tools/workbench-launcher/vite.config.js",
    "launcher:typecheck": "vue-tsc --noEmit -p tools/workbench-launcher/tsconfig.json",
    "launcher:test:e2e": "playwright test --config tools/workbench-launcher/playwright.config.js",
    "launcher:tauri": "tauri",
    "launcher:tauri:dev": "tauri dev --config tools/workbench-launcher/src-tauri/tauri.conf.json",
    "launcher:tauri:info": "tauri info"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@lucide/vue": "^1.31.0",
    "@tanstack/vue-query": "5.87.1",
    "echarts": "6.1.0",
    "lossless-json": "^4.3.1",
    "pinia": "3.0.3",
    "vue": "^3.5.13",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "ajv": "^8.20.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.5",
    "vite-node": "2.1.9",
    "vitest": "^2.1.8",
    "vue-tsc": "^3.3.11"
  }
}
