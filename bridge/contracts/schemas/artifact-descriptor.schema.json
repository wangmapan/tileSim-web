{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilesim.local/contracts/artifact-descriptor.schema.json",
  "title": "ExpectedAbsenceArtifactDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "artifact_id", "state", "evidence_requirement", "absence_reason", "detail"],
  "properties": {
    "schema_version": { "const": "tilesim.wind_tunnel_artifact_descriptor.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "artifact_id": { "type": "string", "minLength": 1 },
    "state": { "const": "expected_absence" },
    "evidence_requirement": { "type": "string", "minLength": 1 },
    "absence_reason": { "const": "not_expected_for_boundary" },
    "detail": { "type": "string", "minLength": 1 }
  }
}
