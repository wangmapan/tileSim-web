{
  "$id": "tilesim.agent_harness.candidate_set.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "contract_revision",
    "candidate_id",
    "batch_id",
    "sequence",
    "candidate_digest",
    "parent_candidate_id",
    "principal",
    "workspace_id",
    "snapshot_digest",
    "backend_identity",
    "schema_set_revision",
    "policy_revision",
    "config",
    "diff",
    "status",
    "provenance"
  ],
  "properties": {
    "schema_identity": { "const": "tilesim.agent_harness.candidate_set.v1" },
    "contract_revision": { "const": "2026-10-19.wpe.v1" },
    "candidate_id": { "type": "string" },
    "batch_id": { "type": "string" },
    "sequence": { "type": "integer", "minimum": 0 },
    "candidate_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "parent_candidate_id": { "type": ["string", "null"] },
    "principal": { "type": "string" },
    "workspace_id": { "type": "string" },
    "snapshot_digest": { "type": "string" },
    "backend_identity": { "type": "object" },
    "schema_set_revision": { "type": "string" },
    "policy_revision": { "type": "string" },
    "config": { "type": "object" },
    "diff": { "type": "object" },
    "status": { "type": "string" },
    "operation_id": { "type": ["string", "null"] },
    "run_id": { "type": ["string", "null"] },
    "artifact_manifest_digest": { "type": ["string", "null"] },
    "result": { "type": ["object", "null"] },
    "failure": { "type": ["object", "null"] },
    "provenance": { "type": "object" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
