{
  "$id": "tilesim.agent_harness.deployment_exploration_constraint.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "contract_revision",
    "schema_set_revision",
    "metric_path",
    "operator",
    "threshold"
  ],
  "properties": {
    "schema_identity": {
      "type": "string"
    },
    "contract_revision": {
      "const": "2026-11-01.wph.v1"
    },
    "schema_set_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "metric_path": {
      "type": "string",
      "pattern": "^/[^/].*"
    },
    "operator": {
      "enum": [
        "<",
        "<=",
        "=",
        ">=",
        ">"
      ]
    },
    "threshold": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    }
  }
}
