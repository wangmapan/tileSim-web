{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tilesim.agent_harness.draft_validation_report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "contract_revision",
    "draft_id",
    "draft_digest",
    "validation_id",
    "principal",
    "workspace_id",
    "input_snapshot_digest",
    "validator_revision",
    "schema_set_revision",
    "backend_identity",
    "policy_revision",
    "status",
    "issues",
    "field_results",
    "unsupported_fields",
    "stale_reasons",
    "budget_estimate",
    "risk_flags",
    "would_create_run",
    "validated_create_run_request_digest",
    "created_at"
  ],
  "properties": {
    "schema_identity": { "const": "tilesim.agent_harness.draft_validation_report.v1" },
    "contract_revision": { "const": "2026-10-18.wpb.v1" },
    "draft_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "draft_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "validation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "principal": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "input_snapshot_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "validator_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
    "schema_set_revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "backend_identity": { "type": "object", "minProperties": 1, "additionalProperties": true },
    "policy_revision": { "const": "tilesim.agent_harness.policy.v1" },
    "status": { "enum": ["valid", "invalid", "unsupported", "unavailable", "stale", "expired", "rejected"] },
    "issues": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["error", "warning", "info"] },
          "message": { "type": "string", "maxLength": 512 },
          "field_path": { "type": ["string", "null"] }
        }
      }
    },
    "field_results": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_id", "status"],
        "properties": {
          "field_id": { "type": "string", "minLength": 1 },
          "json_pointer": { "type": ["string", "null"] },
          "status": { "enum": ["valid", "invalid", "unsupported", "unavailable", "stale"] },
          "reason": { "type": ["string", "null"] }
        }
      }
    },
    "unsupported_fields": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1 } },
    "stale_reasons": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
    "budget_estimate": { "type": "object", "additionalProperties": true },
    "risk_flags": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 256 } },
    "would_create_run": { "const": false },
    "validated_create_run_request_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
