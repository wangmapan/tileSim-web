{
  "$id": "tilesim.agent_harness.optimization_session.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "contract_revision",
    "session_id",
    "principal",
    "workspace_id",
    "input_snapshot_digest",
    "schema_set_revision",
    "backend_identity",
    "policy_revision",
    "objective",
    "constraints",
    "budget",
    "base_config",
    "local_dev",
    "automatic_submission",
    "provenance"
  ],
  "properties": {
    "schema_identity": { "const": "tilesim.agent_harness.optimization_session.v1" },
    "contract_revision": { "const": "2026-10-19.wpd.v1" },
    "session_id": { "type": "string", "minLength": 1 },
    "principal": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "input_snapshot_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "schema_set_revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "backend_identity": { "type": "object" },
    "policy_revision": { "const": "tilesim.agent_harness.local_optimization.policy.v1" },
    "objective": { "type": "object", "required": ["metric_path"] },
    "constraints": { "type": "array", "maxItems": 32 },
    "budget": { "type": "object" },
    "base_config": { "type": "object" },
    "local_dev": { "const": true },
    "automatic_submission": { "const": false },
    "provenance": {
      "type": "object",
      "required": ["deployment_mode", "source_mode", "claim_scope", "production_status"]
    },
    "state": { "type": "string" },
    "current_candidate_id": { "type": ["string", "null"] },
    "current_iteration": { "type": "integer" },
    "run_count": { "type": "integer" },
    "failure_count": { "type": "integer" },
    "execution_request": { "type": ["object", "null"] },
    "active_operation_id": { "type": ["string", "null"] },
    "summary": { "type": ["object", "null"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
