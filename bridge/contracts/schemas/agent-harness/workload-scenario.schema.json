{
  "$id": "tilesim.agent_harness.deployment_exploration_workload_scenario.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "contract_revision",
    "schema_set_revision",
    "scenario_id"
  ],
  "properties": {
    "schema_identity": {
      "type": "string"
    },
    "contract_revision": {
      "const": "2026-11-01.wph.v1"
    },
    "schema_set_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "arrival_rate": {
      "type": "number"
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "burst_mode": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  }
}
