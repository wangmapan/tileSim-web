{
  "$id": "tilesim.agent_harness.deployment_exploration_recommendation.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "contract_revision",
    "schema_set_revision",
    "recommendation_id",
    "field",
    "value",
    "source",
    "reason",
    "confirmed"
  ],
  "properties": {
    "schema_identity": {
      "type": "string"
    },
    "contract_revision": {
      "const": "2026-11-01.wph.v1"
    },
    "schema_set_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "recommendation_id": {
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "value": {},
    "source": {
      "const": "system_recommendation"
    },
    "reason": {
      "type": "string"
    },
    "confirmed": {
      "type": "boolean"
    },
    "confirmed_by": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
