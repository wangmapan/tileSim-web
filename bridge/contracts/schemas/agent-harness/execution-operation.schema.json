{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tilesim.agent_harness.execution_operation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "contract_revision",
    "execution_id",
    "operation_id",
    "draft_id",
    "approval_id",
    "validation_id",
    "draft_digest",
    "approval_digest",
    "input_snapshot_digest",
    "schema_set_revision",
    "backend_identity",
    "policy_revision",
    "workflow_revision",
    "idempotency_key",
    "request_digest",
    "principal",
    "workspace_id",
    "run_id",
    "state",
    "created_at",
    "updated_at",
    "attempt_count",
    "retryable",
    "unknown_outcome",
    "cancellation_fence",
    "result",
    "error"
  ],
  "properties": {
    "schema_identity": { "const": "tilesim.agent_harness.execution_operation.v1" },
    "contract_revision": { "const": "2026-10-18.wpc.v1" },
    "execution_id": { "type": "string" },
    "operation_id": { "type": "string" },
    "draft_id": { "type": "string" },
    "approval_id": { "type": "string" },
    "validation_id": { "type": "string" },
    "draft_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "approval_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "input_snapshot_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "schema_set_revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "backend_identity": { "type": "object" },
    "policy_revision": { "type": "string" },
    "workflow_revision": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "request_digest": { "type": "string" },
    "principal": { "type": "string" },
    "workspace_id": { "type": "string" },
    "run_id": { "type": ["string", "null"] },
    "state": {
      "enum": [
        "submitted",
        "queued",
        "preparing",
        "running",
        "waiting_artifacts",
        "completed",
        "failed",
        "cancel_requested",
        "cancelled",
        "retrying",
        "recovery_required",
        "manual_intervention_required"
      ]
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "attempt_count": { "type": "integer", "minimum": 0 },
    "retryable": { "type": "boolean" },
    "unknown_outcome": { "type": "boolean" },
    "cancellation_fence": { "type": ["string", "null"] },
    "result": { "type": ["object", "null"] },
    "error": { "type": ["object", "null"] }
  }
}
