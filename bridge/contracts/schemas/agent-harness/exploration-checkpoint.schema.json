{
  "$id": "tilesim.agent_harness.exploration_checkpoint.v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "contract_revision", "session_id", "checkpoint_id", "state_digest", "last_event_sequence", "active_run_id", "context_revision", "authorization_digest", "provenance"],
  "properties": {
    "schema_identity": { "const": "tilesim.agent_harness.exploration_checkpoint.v2" },
    "contract_revision": { "const": "2026-10-29.wpg.v2" },
    "session_id": { "type": "string", "minLength": 1 },
    "checkpoint_id": { "type": "string", "minLength": 1 },
    "state_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "last_event_sequence": { "type": "integer", "minimum": 0 },
    "active_run_id": { "type": ["string", "null"] },
    "context_revision": { "type": "string", "minLength": 1 },
    "authorization_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "provenance": { "$ref": "./exploration-provenance.schema.json" }
  }
}
