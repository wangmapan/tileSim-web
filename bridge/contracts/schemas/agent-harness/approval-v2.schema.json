{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tilesim.agent_harness.approval.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "contract_revision",
    "approval_id",
    "draft_id",
    "draft_digest",
    "validation_id",
    "principal",
    "workspace_id",
    "policy_revision",
    "schema_set_revision",
    "backend_identity",
    "status",
    "created_at",
    "expires_at",
    "approved_at",
    "rejected_at",
    "revoked_at",
    "reason",
    "approval_digest",
    "single_use",
    "consumed"
  ],
  "properties": {
    "schema_identity": { "const": "tilesim.agent_harness.approval.v2" },
    "contract_revision": { "const": "2026-10-18.wpb.v1" },
    "approval_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "draft_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "draft_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "validation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "principal": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "policy_revision": { "const": "tilesim.agent_harness.policy.v1" },
    "schema_set_revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "backend_identity": { "type": "object", "minProperties": 1, "additionalProperties": true },
    "status": { "enum": ["pending", "approved", "rejected", "expired", "revoked", "stale"] },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "approved_at": { "type": ["string", "null"], "format": "date-time" },
    "rejected_at": { "type": ["string", "null"], "format": "date-time" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" },
    "reason": { "type": ["string", "null"], "maxLength": 512 },
    "approval_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "single_use": { "type": "boolean" },
    "consumed": { "type": "boolean" }
  }
}
