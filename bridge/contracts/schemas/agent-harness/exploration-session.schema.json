{
  "$id": "tilesim.agent_harness.exploration_session.v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity", "contract_revision", "session_id", "task_type", "principal", "workspace_id",
    "run_id", "context_revision", "run_context_revision", "input_snapshot_digest", "schema_set_revision",
    "backend_identity", "parameter_catalog_revision", "policy_revision", "objective", "parameter_grants",
    "budget", "base_config", "allowed_pages", "allowed_actions", "state", "current_page_id", "current_round",
    "run_count", "failure_count", "no_improvement_count", "active_run_id", "best_candidate_id", "authorization_id",
    "authorization_digest", "context_lock", "local_dev", "automatic_submission", "provenance", "stop_reason",
    "created_at", "updated_at"
  ],
  "properties": {
    "schema_identity": { "const": "tilesim.agent_harness.exploration_session.v2" },
    "contract_revision": { "const": "2026-10-29.wpg.v2" },
    "session_id": { "type": "string", "minLength": 1 },
    "task_type": { "const": "explore_experiment" },
    "principal": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": ["string", "null"] },
    "context_revision": { "type": "string", "minLength": 1 },
    "run_context_revision": { "type": ["string", "null"] },
    "input_snapshot_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "schema_set_revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "backend_identity": { "type": "object", "minProperties": 1 },
    "parameter_catalog_revision": { "type": "string", "minLength": 1 },
    "policy_revision": { "const": "tilesim.agent_harness.serial_exploration.policy.v2" },
    "objective": { "$ref": "./exploration-objective.schema.json" },
    "parameter_grants": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "./exploration-parameter-grant.schema.json" } },
    "budget": { "$ref": "./exploration-budget.schema.json" },
    "base_config": { "type": "object", "minProperties": 1 },
    "allowed_pages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["experiment", "execution", "metrics"] } },
    "allowed_actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["navigate", "analyze", "execute", "report"] } },
    "state": { "enum": ["waiting_authorization", "exploring", "waiting_run", "comparing", "paused", "completed", "parameter_validation_failed", "run_failed", "authorization_expired", "authorization_revoked", "budget_exhausted", "context_expired", "recovery_required", "manual_intervention_required", "cancelled"] },
    "current_page_id": { "enum": ["experiment", "execution", "metrics"] },
    "current_round": { "type": "integer", "minimum": 0 },
    "run_count": { "type": "integer", "minimum": 0 },
    "failure_count": { "type": "integer", "minimum": 0 },
    "no_improvement_count": { "type": "integer", "minimum": 0 },
    "active_run_id": { "type": ["string", "null"] },
    "best_candidate_id": { "type": ["string", "null"] },
    "authorization_id": { "type": ["string", "null"] },
    "authorization_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "planning_plan_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "planning_confirmation": { "type": ["object", "null"] },
    "deployment_candidates": { "type": "array" },
    "run_strategy": { "type": ["object", "null"] },
    "run_strategy_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "context_lock": {
      "type": "object", "additionalProperties": false,
      "required": ["page_ids", "context_revision", "input_snapshot_digest", "locked"],
      "properties": {
        "page_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "context_revision": { "type": "string", "minLength": 1 },
        "input_snapshot_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "locked": { "const": true }
      }
    },
    "local_dev": { "const": true },
    "automatic_submission": { "const": true },
    "provenance": { "$ref": "./exploration-provenance.schema.json" },
    "stop_reason": { "anyOf": [{ "$ref": "./exploration-stop-reason.schema.json" }, { "type": "null" }] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "error": { "type": ["object", "null"] }
  }
}
