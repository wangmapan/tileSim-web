{
  "$id": "tilesim.agent_harness.experiment_plan.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "contract_revision",
    "plan_digest",
    "snapshot_digest",
    "parent_batch_id",
    "principal",
    "workspace_id",
    "backend_identity",
    "schema_set_revision",
    "policy_revision",
    "steps"
  ],
  "properties": {
    "schema_identity": { "const": "tilesim.agent_harness.experiment_plan.v1" },
    "contract_revision": { "const": "2026-10-19.wpe.v1" },
    "plan_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "snapshot_digest": { "type": "string" },
    "parent_batch_id": { "type": ["string", "null"] },
    "principal": { "type": "string" },
    "workspace_id": { "type": "string" },
    "backend_identity": { "type": "object" },
    "schema_set_revision": { "type": "string" },
    "policy_revision": { "type": "string" },
    "steps": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "object" } },
    "provenance": { "type": "object" }
  }
}
