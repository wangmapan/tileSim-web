{
  "$id": "tilesim.agent_harness.stop_reason.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "contract_revision", "batch_id", "reason", "detail", "provenance"],
  "properties": {
    "schema_identity": { "const": "tilesim.agent_harness.stop_reason.v1" },
    "contract_revision": { "const": "2026-10-19.wpe.v1" },
    "batch_id": { "type": "string" },
    "reason": {
      "enum": [
        "candidate_set_exhausted",
        "run_budget_exhausted",
        "time_budget_exhausted",
        "failure_budget",
        "no_improvement",
        "cancelled",
        "recovery_required"
      ]
    },
    "detail": { "type": "string" },
    "provenance": { "type": "object" }
  }
}
