{
  "$id": "tilesim.agent_harness.exploration_iteration.v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_identity", "contract_revision", "session_id", "iteration_id", "sequence", "candidate_id", "state", "run_id", "metric_verified", "created_at", "provenance"],
  "properties": {
    "schema_identity": { "const": "tilesim.agent_harness.exploration_iteration.v2" },
    "contract_revision": { "const": "2026-10-29.wpg.v2" },
    "session_id": { "type": "string", "minLength": 1 },
    "iteration_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "state": { "enum": ["generated", "validated", "waiting_run", "comparing", "completed", "failed", "recovery_required"] },
    "run_id": { "type": ["string", "null"] },
    "metric_verified": { "type": "boolean" },
    "created_at": { "type": "string", "format": "date-time" },
    "provenance": { "$ref": "./exploration-provenance.schema.json" }
  }
}
