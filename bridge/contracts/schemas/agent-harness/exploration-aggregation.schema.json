{
  "$id": "tilesim.agent_harness.deployment_exploration_aggregation.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "contract_revision",
    "schema_set_revision",
    "rule",
    "scenario_ids"
  ],
  "properties": {
    "schema_identity": {
      "type": "string"
    },
    "contract_revision": {
      "const": "2026-11-01.wph.v1"
    },
    "schema_set_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rule": {
      "enum": [
        "all_scenarios",
        "mean",
        "max",
        "min",
        "p95"
      ]
    },
    "scenario_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
