{
  "$id": "tilesim.agent_harness.batch_session.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "contract_revision",
    "batch_id",
    "principal",
    "workspace_id",
    "input_snapshot_digest",
    "schema_set_revision",
    "backend_identity",
    "policy_revision",
    "plan",
    "candidate_set",
    "objective",
    "budget",
    "concurrency_policy",
    "stop_policy",
    "approval_required",
    "auto_execute",
    "local_dev",
    "provenance"
  ],
  "properties": {
    "schema_identity": { "const": "tilesim.agent_harness.batch_session.v1" },
    "contract_revision": { "const": "2026-10-19.wpe.v1" },
    "batch_id": { "type": "string", "minLength": 1 },
    "principal": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "input_snapshot_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "schema_set_revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "backend_identity": { "type": "object" },
    "policy_revision": { "const": "tilesim.agent_harness.local_batch.policy.v1" },
    "plan": { "type": "object" },
    "candidate_set": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "object" } },
    "objective": { "$ref": "./batch-objective.schema.json" },
    "budget": { "$ref": "./batch-budget.schema.json" },
    "concurrency_policy": { "$ref": "./concurrency-policy.schema.json" },
    "stop_policy": { "$ref": "./stop-policy.schema.json" },
    "execution_request": { "type": ["object", "null"] },
    "approval_required": { "const": true },
    "auto_execute": { "type": "boolean" },
    "local_dev": { "const": true },
    "provenance": {
      "type": "object",
      "required": ["deployment_mode", "source_mode", "claim_scope", "production_status"]
    },
    "state": { "type": "string" },
    "status": { "type": "string" },
    "approval": { "$ref": "./batch-approval.schema.json" },
    "summary": { "type": ["object", "null"] },
    "stop_reason": { "type": ["object", "null"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
