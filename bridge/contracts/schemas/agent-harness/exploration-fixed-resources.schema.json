{
  "$id": "tilesim.agent_harness.deployment_exploration_fixed_resources.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "contract_revision",
    "schema_set_revision",
    "model",
    "engine",
    "gpu_type",
    "gpu_count"
  ],
  "properties": {
    "schema_identity": {
      "type": "string"
    },
    "contract_revision": {
      "const": "2026-11-01.wph.v1"
    },
    "schema_set_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "gpu_type": {
      "type": "string",
      "minLength": 1
    },
    "gpu_count": {
      "type": "integer",
      "minimum": 1
    },
    "precision": {
      "type": "string"
    },
    "node_count": {
      "type": "integer",
      "minimum": 1
    },
    "resource_budget": {
      "type": "object"
    }
  }
}
