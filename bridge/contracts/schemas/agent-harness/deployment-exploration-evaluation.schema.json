{
  "$id": "tilesim.agent_harness.deployment_exploration_evaluation.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "contract_revision",
    "schema_set_revision",
    "candidate_id",
    "eligible"
  ],
  "properties": {
    "schema_identity": {
      "type": "string"
    },
    "contract_revision": {
      "const": "2026-11-01.wph.v1"
    },
    "schema_set_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidate_id": {
      "type": "string"
    },
    "eligible": {
      "type": "boolean"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "objective_value": {
      "type": "number"
    },
    "direction": {
      "enum": [
        "minimize",
        "maximize"
      ]
    },
    "aggregation": {
      "type": "string"
    },
    "scenario_evaluations": {
      "type": "array"
    },
    "constraints": {
      "type": "array"
    },
    "evidence_refs": {
      "type": "array"
    }
  }
}
