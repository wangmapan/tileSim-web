{
  "$id": "tilesim.agent_harness.batch_budget.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "max_candidates",
    "max_runs",
    "max_seconds",
    "max_concurrency",
    "max_failures",
    "max_retries",
    "resource_units",
    "max_no_improvement"
  ],
  "properties": {
    "max_candidates": { "type": "integer", "minimum": 1, "maximum": 32 },
    "max_runs": { "type": "integer", "minimum": 1, "maximum": 32 },
    "max_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "max_concurrency": { "const": 1 },
    "max_failures": { "type": "integer", "minimum": 1, "maximum": 8 },
    "max_retries": { "type": "integer", "minimum": 1, "maximum": 3 },
    "resource_units": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "max_no_improvement": { "type": "integer", "minimum": 1, "maximum": 32 }
  }
}
