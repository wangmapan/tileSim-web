{
  "$id": "tilesim.agent_harness.optimization_authorization.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "contract_revision",
    "authorization_id",
    "session_id",
    "principal",
    "workspace_id",
    "schema_set_revision",
    "backend_identity",
    "input_snapshot_digest",
    "autonomy_level",
    "budget",
    "parameter_grants",
    "objective",
    "tool_allowlist",
    "allowed_pages",
    "allowed_actions",
    "protected",
    "status",
    "issued_by",
    "issued_at",
    "expires_at",
    "revoked_at",
    "provenance",
    "authorization_digest"
  ],
  "properties": {
    "schema_identity": { "const": "tilesim.agent_harness.optimization_authorization.v1" },
    "contract_revision": { "const": "2026-10-28.wpf.v1" },
    "authorization_id": { "type": "string", "pattern": "^authz-.+" },
    "session_id": { "type": "string", "minLength": 1 },
    "principal": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "schema_set_revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "backend_identity": { "type": "object" },
    "input_snapshot_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "autonomy_level": { "enum": ["bounded_autonomous", "human_approves_each"] },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_rounds",
        "max_runs",
        "max_seconds",
        "max_failures",
        "max_model_calls",
        "max_tool_calls_per_round",
        "max_navigation_attempts",
        "max_run_creations",
        "max_execution_time_ms"
      ],
      "properties": {
        "max_rounds": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max_runs": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "max_failures": { "type": "integer", "minimum": 1, "maximum": 5 },
        "max_model_calls": { "type": "integer", "minimum": 1, "maximum": 60 },
        "max_tool_calls_per_round": { "type": "integer", "minimum": 1, "maximum": 4 },
        "max_navigation_attempts": { "type": "integer", "minimum": 1, "maximum": 8 },
        "max_run_creations": { "type": "integer", "minimum": 1, "maximum": 1 },
        "max_execution_time_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 }
      }
    },
    "parameter_grants": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pointer", "min", "max", "step", "kind"],
        "properties": {
          "pointer": { "type": "string", "pattern": "^/[^/].*" },
          "min": { "type": "number", "finite": true },
          "max": { "type": "number", "finite": true },
          "step": { "type": "number", "exclusiveMinimum": 0, "finite": true },
          "kind": { "enum": ["int", "integer", "number", "float"] }
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_path", "direction", "minimum_improvement", "plateau_rounds"],
      "properties": {
        "metric_path": { "type": "string", "pattern": "^/[^/].*" },
        "direction": { "enum": ["minimize", "maximize"] },
        "minimum_improvement": { "type": "number", "minimum": 0 },
        "plateau_rounds": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "tool_allowlist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "enum": ["get_capability_catalog", "get_run_status", "list_run_evidence", "query_verified_metrics"] }
    },
    "allowed_pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "enum": ["overview", "execution", "replay", "metrics", "fabric", "attribution", "validation", "raw_evidence", "evidence_agent", "evidence_lab", "design_space", "history", "experiment"] }
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "enum": ["explain", "navigate", "analyze", "report", "draft", "execute"] }
    },
    "protected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_mode", "claim_scope", "schema_set_revision", "backend_identity"],
      "properties": {
        "source_mode": { "const": "synthetic_trace" },
        "claim_scope": { "const": "exploratory" },
        "schema_set_revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "backend_identity": { "type": "object" }
      }
    },
    "status": { "enum": ["active", "exhausted", "revoked", "expired"] },
    "issued_by": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment_mode", "source_mode", "claim_scope", "production_status"],
      "properties": {
        "deployment_mode": { "const": "local_dev" },
        "source_mode": { "const": "synthetic_trace" },
        "claim_scope": { "const": "exploratory" },
        "production_status": { "const": "not_for_production" }
      }
    },
    "authorization_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 14400 }
  }
}
