{
  "$id": "tilesim.agent_harness.deployment_exploration_run_strategy.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_identity",
    "contract_revision",
    "schema_set_revision"
  ],
  "properties": {
    "schema_identity": {
      "type": "string"
    },
    "contract_revision": {
      "const": "2026-11-01.wph.v1"
    },
    "schema_set_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "batch_scheduler": {
      "type": "string"
    },
    "max_batch_size": {
      "type": "integer",
      "minimum": 1
    },
    "kv_cache_capacity_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "message_size_multiplier": {
      "type": "number"
    }
  }
}
