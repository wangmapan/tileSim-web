{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilesim.local/contracts/tail-cause-chain-report.schema.json",
  "title": "TailCauseChainReportV1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "run_id", "cause_chain", "attribution_ranking"],
  "$defs": {
    "networkInterval": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "component_code": { "type": "string" },
        "demand_id": { "type": "string" },
        "link_id": { "type": "string" },
        "attempt": { "$ref": "f6b-common.schema.json#/$defs/uint64" },
        "start_time_ps": { "$ref": "f6b-common.schema.json#/$defs/uint64" },
        "end_time_ps": { "$ref": "f6b-common.schema.json#/$defs/uint64" },
        "evidence": { "type": "string" },
        "unresolved_reason": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "$ref": "f6b-common.schema.json#/$defs/evidenceRef" } }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": true,
      "required": ["cause_id", "subject_refs", "evidence_refs"],
      "properties": {
        "cause_id": { "type": "string", "minLength": 1 },
        "subject_refs": { "type": "array", "items": { "$ref": "f6b-common.schema.json#/$defs/subjectRef" } },
        "evidence_refs": { "type": "array", "items": { "$ref": "f6b-common.schema.json#/$defs/evidenceRef" } },
        "start_time_ps": { "$ref": "f6b-common.schema.json#/$defs/uint64" },
        "end_time_ps": { "$ref": "f6b-common.schema.json#/$defs/uint64" },
        "subsystem": { "type": "string" },
        "cause_code": { "type": "string" },
        "title": { "type": "string" },
        "evidence": { "type": "string" },
        "model_execution_call_id": { "type": "string" },
        "execution_id": { "type": "string" },
        "kv_operation_id": { "type": "string" },
        "network_demand_id": { "type": "string" },
        "device_task_id": { "type": "string" },
        "collective_id": { "type": "string" },
        "pd_handoff_id": { "type": "string" },
        "pd_disaggregation_group_id": { "type": "string" },
        "pd_source_placement_group_id": { "type": "string" },
        "pd_destination_placement_group_id": { "type": "string" },
        "network_intervals": { "type": "array", "items": { "$ref": "#/$defs/networkInterval" } }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": true,
      "required": ["attribution_id", "subject_refs", "evidence_refs"],
      "properties": {
        "attribution_id": { "type": "string", "minLength": 1 },
        "subject_refs": { "type": "array", "items": { "$ref": "f6b-common.schema.json#/$defs/subjectRef" } },
        "evidence_refs": { "type": "array", "items": { "$ref": "f6b-common.schema.json#/$defs/evidenceRef" } },
        "rank": { "$ref": "f6b-common.schema.json#/$defs/uint64" },
        "score_ps": { "type": "number" },
        "share": { "type": "number" },
        "subsystem": { "type": "string" },
        "component_code": { "type": "string" },
        "title": { "type": "string" },
        "detail": { "type": "string" }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "tilesim.tail_cause_chain_report.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "cause_chain": {
      "type": "array",
      "items": { "$ref": "#/$defs/cause" }
    },
    "attribution_ranking": {
      "type": "array",
      "items": { "$ref": "#/$defs/attribution" }
    }
  }
}
