{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilesim.local/contracts/trace-package-catalog.schema.json",
  "x-tilesim-schema-identity": "tilesim.bridge.trace_package_catalog.v1",
  "title": "TracePackageCatalogResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_package_schema_identity",
    "schema_set_revision",
    "backend_identity",
    "capability",
    "packages",
    "discovery_errors"
  ],
  "properties": {
    "schema_version": { "const": "tilesim.bridge.trace_package_catalog.v1" },
    "trace_package_schema_identity": { "const": "tilesim.trace_package.v1alpha1" },
    "schema_set_revision": { "$ref": "#/$defs/revision" },
    "backend_identity": { "$ref": "#/$defs/tracePackageBackendIdentity" },
    "capability": { "$ref": "#/$defs/tracePackageCapability" },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/tracePackageItem" }
    },
    "discovery_errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/tracePackageError" }
    }
  },
  "$defs": {
    "revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "tracePackageBackendIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_revision": { "type": "string" },
        "build_revision": { "type": "string" },
        "source_state_digest": { "type": "string" },
        "build_state_digest": { "type": "string" },
        "versions_match": { "type": "boolean" },
        "state_digests_match": { "type": "boolean" },
        "deployment_mode": { "type": "string" },
        "deployment_ref": { "type": "string" }
      }
    },
    "tracePackageCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "reason"],
      "properties": {
        "available": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "tracePackageError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "candidate": { "type": "string" },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "tracePackageProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_mode",
        "calibration_level",
        "allowed_claim_scope",
        "source_id",
        "generation_path",
        "capture_or_generation_time",
        "upstream_tooling",
        "trace_kind",
        "notes"
      ],
      "properties": {
        "source_mode": { "enum": ["real_trace", "synthetic_trace", "compatibility_harness_trace"] },
        "calibration_level": {
          "enum": ["uncalibrated", "partially_calibrated", "calibrated", "held_out_validated"]
        },
        "allowed_claim_scope": {
          "enum": ["exploratory", "comparative", "calibrated_prediction", "held_out_validation"]
        },
        "source_id": { "type": "string", "minLength": 1 },
        "generation_path": { "type": "string", "minLength": 1 },
        "capture_or_generation_time": { "type": "string", "minLength": 1 },
        "upstream_tooling": { "type": "string", "minLength": 1 },
        "trace_kind": { "const": "trace_package" },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tracePackageArtifactIntegrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "semantic_artifact_count", "semantic_roles", "sha256_verified", "entry_trace_verified"],
      "properties": {
        "complete": { "type": "boolean" },
        "semantic_artifact_count": { "type": "integer", "minimum": 0, "maximum": 6 },
        "semantic_roles": {
          "type": "array",
          "items": { "enum": ["request", "batch", "iteration", "tile_execution", "kv_cache", "network_flow"] },
          "uniqueItems": true
        },
        "sha256_verified": { "type": "boolean" },
        "entry_trace_verified": { "type": "boolean" }
      }
    },
    "tracePackageProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "tracePackageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "manifest_sha256",
        "inspect_status",
        "inspect_errors",
        "submission_available",
        "unavailable_reason",
        "artifact_integrity"
      ],
      "properties": {
        "package_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "producer": { "$ref": "#/$defs/tracePackageProducer" },
        "experiment_id": { "type": "string", "minLength": 1 },
        "physical_run_id": { "type": "string", "minLength": 1 },
        "entry_boundary": { "enum": ["S0", "S1", "S2", "S3", "S4", "S5"] },
        "entry_trace_kind": {
          "enum": ["s0_workload", "s1_runtime", "s2_execution", "s2_kernel", "s3_memory", "s4_device", "s5_collective"]
        },
        "trace_provenance": { "$ref": "#/$defs/tracePackageProvenance" },
        "manifest_sha256": { "$ref": "#/$defs/revision" },
        "inspect_status": { "enum": ["valid", "invalid"] },
        "inspect_errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/tracePackageError" }
        },
        "submission_available": { "type": "boolean" },
        "unavailable_reason": { "type": ["string", "null"] },
        "artifact_integrity": { "$ref": "#/$defs/tracePackageArtifactIntegrity" }
      }
    }
  }
}
