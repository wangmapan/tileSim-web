{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilesim.local/contracts/validation-report.schema.json",
  "title": "ValidationReportV1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "run_id", "checks"],
  "properties": {
    "schema_version": { "const": "tilesim.validation_report.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["check_id", "subject_refs", "evidence_refs"],
        "properties": {
          "check_id": { "type": "string", "minLength": 1 },
          "subject_refs": { "type": "array", "items": { "$ref": "f6b-common.schema.json#/$defs/subjectRef" } },
          "evidence_refs": { "type": "array", "items": { "$ref": "f6b-common.schema.json#/$defs/evidenceRef" } }
        }
      }
    }
  }
}
